{
  "name": "sftp-streaming",
  "version": "0.0.1",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build": "tsdown",
    "publish": "npm run build && prism components:publish",
    "generate:manifest": "npm run build && npx @prismatic-io/spectral component-manifest",
    "generate:manifest:dev": "npm run build && npx @prismatic-io/spectral component-manifest --skip-signature-verify",
    "test": "vitest run",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prismatic-io/spectral": "10.37.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^22.20.5",
    "@types/ssh2-sftp-client": "^9.0.6",
    "tsdown": "0.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  }
}
